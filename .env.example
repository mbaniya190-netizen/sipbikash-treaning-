# Google Cloud service account credentials (server-side only; do not prefix with NEXT_PUBLIC_)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. Defaults to Leads. This is the tab name inside the spreadsheet.
GOOGLE_SHEETS_TAB=Leads
